#!/bin/bash
# Start/stop the Dockhook backend.

NAME="dockhook"
BASE="/usr/local/$NAME"
NODE="$BASE/bin/node"
APP="$BASE/dockhook.mjs"
PIDFILE="/var/run/$NAME.pid"
LOGFILE="/var/log/$NAME.log"
CONFIG="/boot/config/plugins/$NAME/$NAME.cfg"

is_running() {
  [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null
}

start() {
  if is_running; then
    echo "$NAME is already running (pid $(cat "$PIDFILE"))"
    return 0
  fi
  if [ ! -f "$CONFIG" ]; then
    echo "$NAME: missing config at $CONFIG — configure it in the WebGUI first"
    return 1
  fi
  echo "Starting $NAME..."
  nohup "$NODE" "$APP" >>"$LOGFILE" 2>&1 &
  echo $! > "$PIDFILE"
  sleep 1
  if is_running; then
    echo "$NAME started (pid $(cat "$PIDFILE"))"
  else
    echo "$NAME failed to start — see $LOGFILE"
    rm -f "$PIDFILE"
    return 1
  fi
}

stop() {
  if ! is_running; then
    echo "$NAME is not running"
    rm -f "$PIDFILE"
    return 0
  fi
  echo "Stopping $NAME..."
  kill "$(cat "$PIDFILE")" 2>/dev/null
  for _ in $(seq 1 10); do
    is_running || break
    sleep 1
  done
  is_running && kill -9 "$(cat "$PIDFILE")" 2>/dev/null
  rm -f "$PIDFILE"
  echo "$NAME stopped"
}

status() {
  if is_running; then
    echo "$NAME is running (pid $(cat "$PIDFILE"))"
  else
    echo "$NAME is stopped"
    return 1
  fi
}

case "$1" in
  start)   start ;;
  stop)    stop ;;
  restart) stop; start ;;
  status)  status ;;
  *)       echo "usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
