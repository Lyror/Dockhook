#!/bin/bash
# Start/stop the Dockhook backend.

NAME="dockhook"
BASE="/usr/local/$NAME"
NODE="$BASE/bin/node"
APP="$BASE/dockhook.mjs"
PIDFILE="/var/run/$NAME.pid"
LOGFILE="/var/log/$NAME.log"
STARTUP_LOG="/var/log/dockhook.startup.log"
CONFIG_DIR="/boot/config/plugins/$NAME"
CONFIG="$CONFIG_DIR/$NAME.cfg"
TARGETS="$CONFIG_DIR/targets.cfg"

is_running() {
  [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null
}

# Generates a default config on first start. This makes the service
# self-sufficient regardless of install method: the .plg's install hook,
# a plain package drop under /boot/extra, or a manual `rc.dockhook
# start` all converge on the same first-run behavior.
seed_config() {
  mkdir -p "$CONFIG_DIR"

  if [ ! -f "$CONFIG" ]; then
    TOKEN=$(head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n')
    cat > "$CONFIG.tmp" <<EOF
TOKEN="$TOKEN"
PORT="8377"
BIND_ADDRESS="0.0.0.0"
ACTION_TIMEOUT_MS="600000"
EOF
    chmod 600 "$CONFIG.tmp"
    mv "$CONFIG.tmp" "$CONFIG"
    echo "$NAME: no config found — generated a random webhook token."
    echo "$NAME: find it under Settings -> Dockhook (or see $CONFIG)."
  fi

  if [ ! -f "$TARGETS" ]; then
    printf '# Target mappings, managed from Settings -> Dockhook\n' > "$TARGETS.tmp"
    chmod 600 "$TARGETS.tmp"
    mv "$TARGETS.tmp" "$TARGETS"
  fi
}

start() {
  if is_running; then
    echo "$NAME is already running (pid $(cat "$PIDFILE"))"
    return 0
  fi
  seed_config
  echo "Starting $NAME..."
  nohup "$NODE" "$APP" >>"$STARTUP_LOG" 2>&1 &
  echo $! > "$PIDFILE"
  sleep 1
  if is_running; then
    echo "$NAME started (pid $(cat "$PIDFILE"))"
  else
    echo "$NAME failed to start — see $STARTUP_LOG"
    rm -f "$PIDFILE"
    return 1
  fi
}

stop() {
  if ! is_running; then
    echo "$NAME is not running"
    rm -f "$PIDFILE"
    return 0
  fi
  echo "Stopping $NAME..."
  kill "$(cat "$PIDFILE")" 2>/dev/null
  for _ in $(seq 1 10); do
    is_running || break
    sleep 1
  done
  is_running && kill -9 "$(cat "$PIDFILE")" 2>/dev/null
  rm -f "$PIDFILE"
  echo "$NAME stopped"
}

status() {
  if is_running; then
    echo "$NAME is running (pid $(cat "$PIDFILE"))"
  else
    echo "$NAME is stopped"
    return 1
  fi
}

case "$1" in
  start)   start ;;
  stop)    stop ;;
  restart) stop; start ;;
  status)  status ;;
  *)       echo "usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
